# ==============================================================================
# DonorPulse Cloud Telephony & SMS Alerts Configuration
# ==============================================================================

# Set to 'false' to enable live PSTN phone ringing and real SMS delivery via Twilio.
# Set to 'true' for local safe testing (no Twilio credits needed; simulates ringing & SMS).
MOCK_TELEPHONY=true

# Twilio Programmable Voice & SMS Credentials
# Retrieve from Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Public Webhook Base URL for Twilio Status Callbacks & IVR Webhooks
# When testing locally with your real phone, run: ngrok http 3000
# and set this to your ngrok forwarding URL (e.g., https://abc123xyz.ngrok-free.app)
PUBLIC_WEBHOOK_BASE_URL=http://localhost:3000

# Telephony Tunables
# Flow A: Maximum ring duration (seconds) before stopping outbound emergency voice call
AUTO_ALERT_RING_TIMEOUT=10

# Flow B: Normal ring duration (seconds) when Patient manually calls donor
MANUAL_CALL_RING_TIMEOUT=40

# Maximum number of eligible donors alerted simultaneously per emergency requisition
MAX_CONCURRENT_DONOR_CALLS=5

# Anti-spam cooldown (seconds) to prevent re-calling the same donor for the same request
ALERT_COOLDOWN_SECONDS=300
